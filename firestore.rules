// ============================================================================
// "16" — regel-blokk for seksten_*-samlingene.
// Dette er IKKE en komplett firestore.rules-fil — det er blokken som skal
// limes inn i det eksisterende, delte rules-dokumentet sammen med reglene
// for de tre andre appene (1 vs 1, stafettliga, klubb-app). Ikke overskriv
// deres regler.
//
// Forutsetning: Firebase Anonymous Auth er slått på, og en Cloud Function
// (verifyAdminPin) setter custom claim `admin: true` på riktig token etter
// server-side PIN-sjekk. Se docs/datamodell.md, avsnitt "Åpne spørsmål".
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Hjelpefunksjoner (navngi dem unikt hvis de eksisterende reglene
    //     allerede har funksjoner med samme navn) ---
    function seksten_isSignedIn() {
      return request.auth != null;
    }

    function seksten_isAdmin() {
      return seksten_isSignedIn() && request.auth.token.admin == true;
    }

    function seksten_isString(v)  { return v is string; }
    function seksten_isNumber(v)  { return v is number; }
    function seksten_isBool(v)    { return v is bool; }
    function seksten_isTimestamp(v) { return v is timestamp; }

    // ---------------------------------------------------------------------
    // seksten_settings/app — singleton
    // ---------------------------------------------------------------------
    match /seksten_settings/{docId} {
      allow read: if true; // trengs uinnlogget (f.eks. TV Mode på en enhet uten init)
      allow write: if seksten_isAdmin()
        && request.resource.data.keys().hasAll(['eventNavn', 'tagline', 'disipliner', 'oppdatert'])
        && seksten_isString(request.resource.data.eventNavn)
        && seksten_isString(request.resource.data.tagline)
        && request.resource.data.disipliner is list;
    }

    // ---------------------------------------------------------------------
    // seksten_spillere/{spillerId} — master-spillerregister
    // ---------------------------------------------------------------------
    match /seksten_spillere/{spillerId} {
      allow read: if seksten_isSignedIn();
      allow create: if seksten_isAdmin()
        && request.resource.data.keys().hasAll(['navn', 'aktiv', 'opprettet', 'stats'])
        && seksten_isString(request.resource.data.navn)
        && request.resource.data.navn.size() > 0
        && seksten_isBool(request.resource.data.aktiv);
      allow update: if seksten_isAdmin()
        && seksten_isString(request.resource.data.navn)
        && seksten_isBool(request.resource.data.aktiv);
      allow delete: if false; // deaktiver (aktiv:false) i stedet for å slette — bevar historikk

      match /historikk/{eventId} {
        allow read: if seksten_isSignedIn();
        // skrives kun av server-/admin-flyt når et event fullføres
        allow write: if seksten_isAdmin();
      }
    }

    // ---------------------------------------------------------------------
    // seksten_events/{eventId} + subcollections
    // ---------------------------------------------------------------------
    match /seksten_events/{eventId} {
      allow read: if true; // spillerflate/TV Mode kan være uinnlogget visning
      allow create, update: if seksten_isAdmin()
        && request.resource.data.keys().hasAll(
             ['navn', 'status', 'eventNummer', 'config', 'gjeldendeRunde', 'sluttspillFase'])
        && request.resource.data.status in
             ['draft', 'registration_open', 'registration_closed',
              'main_event', 'playoffs', 'completed']
        && request.resource.data.sluttspillFase in
             ['none', 'quarterfinal', 'semifinal', 'final', 'completed'];
      allow delete: if false; // fullførte eventer skal aldri kunne slettes (Hall of Fame-historikk)

      match /puljer/{puljeId} {
        allow read: if true;
        allow write: if seksten_isAdmin()
          && request.resource.data.spillerIds is list
          && request.resource.data.spillerIds.size() <= 4;
      }

      match /spillere/{rosterSpillerId} {
        allow read: if true;
        allow write: if seksten_isAdmin()
          && request.resource.data.keys().hasAll(
               ['spillerId', 'navn', 'kvalifiseringsstatusKilde', 'qualifiedForNext'])
          && request.resource.data.kvalifiseringsstatusKilde in
               ['returning_top8', 'qualifier_winner', 'wildcard', 'admin_invite']
          && seksten_isBool(request.resource.data.qualifiedForNext);
      }

      match /kamper/{kampId} {
        allow read: if true; // Courts-visning og TV Mode må kunne leses uinnlogget
        allow create: if seksten_isAdmin()
          && request.resource.data.keys().hasAll(
               ['runde', 'fase', 'bane', 'disiplin', 'spillerA', 'spillerB', 'status'])
          && request.resource.data.disiplin in ['pickleball', 'skyball', 'speedminton']
          && request.resource.data.status in ['scheduled', 'active', 'completed']
          && request.resource.data.fase in ['pool', 'quarterfinal', 'semifinal', 'final'];
        // update dekker: admin registrerer resultat, starter/pauser timer, overstyrer
        allow update: if seksten_isAdmin()
          && request.resource.data.status in ['scheduled', 'active', 'completed'];
        allow delete: if false;
      }

      match /leaderboard/{puljeId} {
        allow read: if true; // dette ER det klienten faktisk leser — må være billig og åpent
        // Skrives av admin-klienten i samme batch som kampresultatet,
        // ALDRI beregnet/lest på nytt fra kamper ved hver visning.
        allow write: if seksten_isAdmin()
          && request.resource.data.rangering is list
          && request.resource.data.rangering.size() <= 4;
      }

      match /sluttspill/{fase} {
        allow read: if true;
        allow write: if seksten_isAdmin()
          && request.resource.data.kampIds is list
          && request.resource.data.bestAvSeire == 2;
      }
    }

    // ---------------------------------------------------------------------
    // seksten_live/aktivEvent — det ENESTE dokumentet TV Mode/Courts abonnerer
    // direkte på for å vite hva som er live.
    // ---------------------------------------------------------------------
    match /seksten_live/{docId} {
      allow read: if true;
      allow write: if seksten_isAdmin();
    }

    // ---------------------------------------------------------------------
    // seksten_champions/{championId} — Hall of Fame
    // ---------------------------------------------------------------------
    match /seksten_champions/{championId} {
      allow read: if true;
      allow write: if seksten_isAdmin()
        && request.resource.data.keys().hasAll(
             ['spillerId', 'navn', 'eventNummer', 'eventId', 'dato', 'antallSeireTotalt'])
        && seksten_isString(request.resource.data.navn)
        && seksten_isNumber(request.resource.data.antallSeireTotalt);
    }

    // ---------------------------------------------------------------------
    // seksten_admins/{uid} — kun lesbar oversikt; selve rettigheten er
    // custom claim'et, satt av Cloud Function, ikke av dette dokumentet.
    // ---------------------------------------------------------------------
    match /seksten_admins/{uid} {
      allow read: if seksten_isAdmin();
      allow write: if false; // kun Cloud Functions (Admin SDK, omgår disse reglene) skriver hit
    }
  }
}
